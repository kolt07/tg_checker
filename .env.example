# Скопіюйте цей файл у .env і замініть ключі.
# Ключ Fernet (stdlib, без додаткових пакетів):
# py -c "import secrets,base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# Випадковий API_KEY:
# py -c "import secrets; print(secrets.token_urlsafe(24))"

API_KEY=change-me-please
SESSION_ENCRYPTION_KEY=

POSTGRES_USER=tgchecker
POSTGRES_PASSWORD=tgchecker
POSTGRES_DB=tgchecker
DATABASE_URL=postgresql+asyncpg://tgchecker:tgchecker@postgres:5432/tgchecker
REDIS_URL=redis://redis:6379/0

DEFAULT_PHONE_REGION=UA
RESOLVE_INTERVAL_SECONDS=3
IMPORT_CHUNK_SIZE=5
IMPORT_PAUSE_SECONDS=5
ENRICH_INTERVAL_SECONDS=1
MAX_IMPORT_RETRIES=2
MAX_PHONES=5000
MAX_ACCOUNTS=8
WORKER_CONCURRENCY=4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=30
